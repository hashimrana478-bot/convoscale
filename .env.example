PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/convoscale
DB_POOL_MIN=5
DB_POOL_MAX=30
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379
USE_EMBEDDED_ENGINES=auto
JWT_SECRET=convo-scale-super-secret-jwt-key-32-chars-minimum
JWT_EXPIRES_IN=24h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
LOG_LEVEL=info
